    {
      "cell_type": "code",
      "source": [
        "from pyspark.sql.types import (\n",
        "    StructType,\n",
        "    StructField,\n",
        "    IntegerType,\n",
        "    StringType,\n",
        "    DoubleType,\n",
        "    BooleanType\n",
        ")\n"
      ],
      "metadata": {
        "id": "t4Jb0NI-V7TT"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "data = [\n",
        "    (101, \"Laptop\", \"Electronics\", 65000.0, True),\n",
        "    (102, \"Mouse\", \"Accessories\", 1500.0, True),\n",
        "    (103, \"Monitor\", \"Electronics\", 18000.0, True),\n",
        "    (104, \"Office Chair\", \"Furniture\", 9000.0, False),\n",
        "    (105, \"Keyboard\", \"Accessories\", 3000.0, True)\n",
        "]"
      ],
      "metadata": {
        "id": "HLkGK7gRWG7r"
      },
      "execution_count": 22,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "schema = StructType([\n",
        "    StructField(\"product_id\", IntegerType(), False),\n",
        "    StructField(\"product_name\", StringType(), False),\n",
        "    StructField(\"category\", StringType(), True),\n",
        "    StructField(\"price\", DoubleType(), True),\n",
        "    StructField(\"available\", BooleanType(), True)\n",
        "])"
      ],
      "metadata": {
        "id": "f7M472FYWULg"
      },
      "execution_count": 23,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df = spark.createDataFrame(data, schema)"
      ],
      "metadata": {
        "id": "2Uv5t75fWac4"
      },
      "execution_count": 24,
      "outputs": []
    },
